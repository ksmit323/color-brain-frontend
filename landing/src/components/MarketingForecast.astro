---
/**
 * Shared forecast page shell (EN + ZH). Route files only set locale.
 */
import Marketing from "../layouts/Marketing.astro";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import ForecastPage from "./ForecastPage.astro";
import type { Locale } from "../i18n/locales";
import { forecastHref } from "../i18n/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const path = forecastHref(locale);
---

<Marketing locale={locale} page="forecast">
  <Nav locale={locale} path={path} />
  <ForecastPage locale={locale} />
  <Footer locale={locale} />
</Marketing>
