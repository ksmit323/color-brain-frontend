---
/**
 * Savings Forecast wizard body — locale-aware.
 */
import type { Locale } from "../i18n/locales";
import { getMessages } from "../i18n/messages";
import {
  PRESETS,
  RFT_LIFT_REALIZATION,
  TIME_RATE_PER_MINUTE,
  type PresetId,
} from "../lib/forecast/model";
import { homeHref, sectionHref } from "../i18n/paths";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = getMessages(locale);
const f = m.forecast;
const homePath = homeHref(locale);
const pilotHref = sectionHref(locale, "#contact");
const PRESET_COPY: Record<PresetId, { label: string; hint: string }> = {
  small: { label: f.presetSmall, hint: f.presetSmallHint },
  medium: { label: f.presetMedium, hint: f.presetMediumHint },
  large: { label: f.presetLarge, hint: f.presetLargeHint },
};
const presets = PRESETS.map((p) => ({ id: p.id, ...PRESET_COPY[p.id] }));
---

<main class="forecast" data-step="1">
      <div class="container forecast__shell">
        <div class="forecast__hero-slot" data-forecast-hero-slot>
          <header class="forecast__hero" data-forecast-hero>
            <p class="eyebrow">{f.heroEyebrow}</p>
            <!-- Keep Color Brain on the same line -->
            <h1 class="forecast__title">{f.heroTitleBefore} <span class="nowrap">Color&nbsp;Brain</span> {f.heroTitleAfter}</h1>
            <p class="lede forecast__lede">
              {f.heroLede}
            </p>
          </header>
        </div>

        <div
          id="forecast-wizard"
          class="forecast__wizard"
          data-step="1"
          data-locale={locale}
          aria-label={f.wizardAria}
        >
          <!-- Progress — also clickable step nav -->
          <ol class="forecast__steps" aria-label={f.stepsAria}>
            <li>
              <button
                type="button"
                class="forecast__step is-active"
                data-step-indicator="1"
                data-goto-step="1"
                aria-current="step"
              >
                <span class="forecast__step-num">01</span>
                <span class="forecast__step-label">{f.stepProfile}</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="forecast__step"
                data-step-indicator="2"
                data-goto-step="2"
              >
                <span class="forecast__step-num">02</span>
                <span class="forecast__step-label">{f.stepTune}</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="forecast__step"
                data-step-indicator="3"
                data-goto-step="3"
              >
                <span class="forecast__step-num">03</span>
                <span class="forecast__step-label">{f.stepOutlook}</span>
              </button>
            </li>
          </ol>

          <div class="forecast__stage" data-step-stage>
          <!-- Step 1: Preset -->
          <section
            class="forecast__panel is-active"
            data-step-panel="1"
            aria-labelledby="step1-title"
          >
            <h2 id="step1-title" class="forecast__panel-title">{f.step1Title}</h2>
            <p class="forecast__panel-lede">
              {f.step1Lede}
            </p>
            <div class="forecast__presets" role="group" aria-label={f.presetsAria}>
              {
                presets.map((p) => (
                  <button
                    type="button"
                    class="forecast__preset"
                    data-preset={p.id}
                    aria-pressed="false"
                  >
                    <span class="forecast__preset-label">{p.label}</span>
                    <span class="forecast__preset-hint">{p.hint}</span>
                  </button>
                ))
              }
            </div>
            <div class="forecast__actions">
              <button type="button" class="btn btn--primary" data-goto-2>
                {f.continue}
              </button>
            </div>
          </section>

          <!-- Step 2: Tune -->
          <section
            class="forecast__panel"
            data-step-panel="2"
            hidden
            aria-hidden="true"
            aria-labelledby="step2-title"
          >
            <div class="forecast__panel-head">
              <div>
                <h2 id="step2-title" class="forecast__panel-title">{f.step2Title}</h2>
                <p class="forecast__panel-lede">
                  {f.step2Lede}
                </p>
              </div>
              <div class="forecast__preview" aria-live="polite">
                <span class="forecast__preview-label">{f.previewLabel}</span>
                <span class="forecast__preview-value" data-preview-value>$0</span>
              </div>
            </div>

            <div class="forecast__fields forecast__fields--primary">
              <label class="forecast__field" for="batchesPerMonth">
                <span class="forecast__field-top">
                  <span
                    class="forecast__field-name"
                    tabindex="0"
                    data-tip={f.fieldBatchesTip}
                  >{f.fieldBatches}</span>
                  <span class="forecast__field-tag">{f.fieldBatchesTag}</span>
                </span>
                <span class="forecast__number">
                  <input
                    id="batchesPerMonth"
                    name="batchesPerMonth"
                    type="number"
                    min="0"
                    max="50000"
                    step="1"
                    inputmode="numeric"
                  />
                  <span class="forecast__stepper" aria-hidden="true">
                    <button type="button" class="forecast__stepper-btn forecast__stepper-btn--up" data-spin="up" tabindex="-1" aria-label={f.fieldBatchesInc}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 3.2 10.2 8.4H1.8L6 3.2Z" fill="currentColor"/></svg></button>
                    <button type="button" class="forecast__stepper-btn forecast__stepper-btn--down" data-spin="down" tabindex="-1" aria-label={f.fieldBatchesDec}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 8.8 1.8 3.6h8.4L6 8.8Z" fill="currentColor"/></svg></button>
                  </span>
                </span>
              </label>
              <label class="forecast__field" for="currentRft">
                <span class="forecast__field-top">
                  <span
                    class="forecast__field-name"
                    tabindex="0"
                    data-tip={f.fieldCurrentRftTip}
                  >{f.fieldCurrentRft}</span>
                  <span class="forecast__field-tag">{f.fieldCurrentRftTag}</span>
                </span>
                <span class="forecast__percent">
                  <input
                    id="currentRft"
                    name="currentRft"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    aria-label={f.fieldCurrentRftAria}
                  />
                  <span class="forecast__stepper" aria-hidden="true">
                    <button type="button" class="forecast__stepper-btn forecast__stepper-btn--up" data-spin="up" tabindex="-1" aria-label={f.fieldCurrentRftInc}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 3.2 10.2 8.4H1.8L6 3.2Z" fill="currentColor"/></svg></button>
                    <button type="button" class="forecast__stepper-btn forecast__stepper-btn--down" data-spin="down" tabindex="-1" aria-label={f.fieldCurrentRftDec}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 8.8 1.8 3.6h8.4L6 8.8Z" fill="currentColor"/></svg></button>
                  </span>
                </span>
              </label>
              <label class="forecast__field" for="targetRft">
                <span class="forecast__field-top">
                  <span
                    class="forecast__field-name"
                    tabindex="0"
                    data-tip={f.fieldTargetRftTip}
                  >{f.fieldTargetRft}</span>
                  <span class="forecast__field-tag">{f.fieldTargetRftTag}</span>
                </span>
                <span class="forecast__percent">
                  <input
                    id="targetRft"
                    name="targetRft"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    aria-label={f.fieldTargetRftAria}
                  />
                  <span class="forecast__stepper" aria-hidden="true">
                    <button type="button" class="forecast__stepper-btn forecast__stepper-btn--up" data-spin="up" tabindex="-1" aria-label={f.fieldTargetRftInc}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 3.2 10.2 8.4H1.8L6 3.2Z" fill="currentColor"/></svg></button>
                    <button type="button" class="forecast__stepper-btn forecast__stepper-btn--down" data-spin="down" tabindex="-1" aria-label={f.fieldTargetRftDec}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 8.8 1.8 3.6h8.4L6 8.8Z" fill="currentColor"/></svg></button>
                  </span>
                </span>
              </label>
            </div>

            <div class="forecast__costs" data-costs>
              <button
                type="button"
                class="forecast__costs-toggle"
                data-costs-toggle
                aria-expanded="false"
                aria-controls="forecast-costs-panel"
                id="forecast-costs-toggle"
              >
                <span class="forecast__costs-summary-label">{f.costsToggle}</span>
                <span class="forecast__costs-summary-hint">{f.costsHint}</span>
              </button>
              <div
                class="forecast__costs-panel"
                id="forecast-costs-panel"
                role="region"
                aria-labelledby="forecast-costs-toggle"
                data-costs-panel
              >
                <div class="forecast__costs-panel-inner">
                <div class="forecast__costs-body">
                <p class="forecast__costs-lede">
                  {f.costsLede}
                </p>
                <div class="forecast__fields forecast__fields--costs">
                  <label class="forecast__field" for="costPerRework">
                    <span class="forecast__field-top">
                      <span
                        class="forecast__field-name"
                        tabindex="0"
                        data-tip={f.fieldLaborTip}
                      >{f.fieldLabor}</span>
                      <span class="forecast__field-tag">{f.fieldLaborTag}</span>
                    </span>
                    <span class="forecast__money">
                      <span class="forecast__money-prefix" aria-hidden="true">$</span>
                      <input
                        id="costPerRework"
                        name="costPerRework"
                        type="number"
                        min="0"
                        step="1"
                        inputmode="decimal"
                        aria-label={f.fieldLaborAria}
                      />
                      <span class="forecast__stepper" aria-hidden="true">
                        <button type="button" class="forecast__stepper-btn forecast__stepper-btn--up" data-spin="up" tabindex="-1" aria-label={f.fieldLaborInc}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 3.2 10.2 8.4H1.8L6 3.2Z" fill="currentColor"/></svg></button>
                        <button type="button" class="forecast__stepper-btn forecast__stepper-btn--down" data-spin="down" tabindex="-1" aria-label={f.fieldLaborDec}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 8.8 1.8 3.6h8.4L6 8.8Z" fill="currentColor"/></svg></button>
                      </span>
                    </span>
                  </label>
                  <label class="forecast__field" for="dyePerRework">
                    <span class="forecast__field-top">
                      <span
                        class="forecast__field-name"
                        tabindex="0"
                        data-tip={f.fieldDyeTip}
                      >{f.fieldDye}</span>
                      <span class="forecast__field-tag">{f.fieldDyeTag}</span>
                    </span>
                    <span class="forecast__money">
                      <span class="forecast__money-prefix" aria-hidden="true">$</span>
                      <input
                        id="dyePerRework"
                        name="dyePerRework"
                        type="number"
                        min="0"
                        step="1"
                        inputmode="decimal"
                        aria-label={f.fieldDyeAria}
                      />
                      <span class="forecast__stepper" aria-hidden="true">
                        <button type="button" class="forecast__stepper-btn forecast__stepper-btn--up" data-spin="up" tabindex="-1" aria-label={f.fieldDyeInc}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 3.2 10.2 8.4H1.8L6 3.2Z" fill="currentColor"/></svg></button>
                        <button type="button" class="forecast__stepper-btn forecast__stepper-btn--down" data-spin="down" tabindex="-1" aria-label={f.fieldDyeDec}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 8.8 1.8 3.6h8.4L6 8.8Z" fill="currentColor"/></svg></button>
                      </span>
                    </span>
                  </label>
                  <label class="forecast__field" for="waterPerRework">
                    <span class="forecast__field-top">
                      <span
                        class="forecast__field-name"
                        tabindex="0"
                        data-tip={f.fieldWaterTip}
                      >{f.fieldWater}</span>
                      <span class="forecast__field-tag">{f.fieldWaterTag}</span>
                    </span>
                    <span class="forecast__money">
                      <span class="forecast__money-prefix" aria-hidden="true">$</span>
                      <input
                        id="waterPerRework"
                        name="waterPerRework"
                        type="number"
                        min="0"
                        step="1"
                        inputmode="decimal"
                        aria-label={f.fieldWaterAria}
                      />
                      <span class="forecast__stepper" aria-hidden="true">
                        <button type="button" class="forecast__stepper-btn forecast__stepper-btn--up" data-spin="up" tabindex="-1" aria-label={f.fieldWaterInc}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 3.2 10.2 8.4H1.8L6 3.2Z" fill="currentColor"/></svg></button>
                        <button type="button" class="forecast__stepper-btn forecast__stepper-btn--down" data-spin="down" tabindex="-1" aria-label={f.fieldWaterDec}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 8.8 1.8 3.6h8.4L6 8.8Z" fill="currentColor"/></svg></button>
                      </span>
                    </span>
                  </label>
                  <label class="forecast__field" for="energyPerRework">
                    <span class="forecast__field-top">
                      <span
                        class="forecast__field-name"
                        tabindex="0"
                        data-tip={f.fieldEnergyTip}
                      >{f.fieldEnergy}</span>
                      <span class="forecast__field-tag">{f.fieldEnergyTag}</span>
                    </span>
                    <span class="forecast__money">
                      <span class="forecast__money-prefix" aria-hidden="true">$</span>
                      <input
                        id="energyPerRework"
                        name="energyPerRework"
                        type="number"
                        min="0"
                        step="1"
                        inputmode="decimal"
                        aria-label={f.fieldEnergyAria}
                      />
                      <span class="forecast__stepper" aria-hidden="true">
                        <button type="button" class="forecast__stepper-btn forecast__stepper-btn--up" data-spin="up" tabindex="-1" aria-label={f.fieldEnergyInc}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 3.2 10.2 8.4H1.8L6 3.2Z" fill="currentColor"/></svg></button>
                        <button type="button" class="forecast__stepper-btn forecast__stepper-btn--down" data-spin="down" tabindex="-1" aria-label={f.fieldEnergyDec}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 8.8 1.8 3.6h8.4L6 8.8Z" fill="currentColor"/></svg></button>
                      </span>
                    </span>
                  </label>
                  <label class="forecast__field" for="cycleMinutes">
                    <span class="forecast__field-top">
                      <span
                        class="forecast__field-name"
                        tabindex="0"
                        data-tip={f.fieldTimeTip}
                      >{f.fieldTime}</span>
                      <span class="forecast__field-tag">{f.fieldTimeTag}</span>
                    </span>
                    <span class="forecast__number">
                      <input
                        id="cycleMinutes"
                        name="cycleMinutes"
                        type="number"
                        min="0"
                        step="5"
                        inputmode="numeric"
                      />
                      <span class="forecast__stepper" aria-hidden="true">
                        <button type="button" class="forecast__stepper-btn forecast__stepper-btn--up" data-spin="up" tabindex="-1" aria-label={f.fieldTimeInc}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 3.2 10.2 8.4H1.8L6 3.2Z" fill="currentColor"/></svg></button>
                        <button type="button" class="forecast__stepper-btn forecast__stepper-btn--down" data-spin="down" tabindex="-1" aria-label={f.fieldTimeDec}><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 8.8 1.8 3.6h8.4L6 8.8Z" fill="currentColor"/></svg></button>
                      </span>
                    </span>
                  </label>
                </div>
                </div>
                </div>
              </div>
            </div>

            <div class="forecast__actions">
              <button type="button" class="btn btn--ghost" data-back-1>{f.back}</button>
              <button type="button" class="btn btn--primary" data-goto-3>
                {f.seeOutlook}
              </button>
            </div>
          </section>

          <!-- Step 3: Reveal -->
          <section
            class="forecast__panel"
            data-step-panel="3"
            hidden
            aria-hidden="true"
            aria-labelledby="step3-title"
          >
            <h2 id="step3-title" class="forecast__panel-title">{f.step3Title}</h2>
            <p class="forecast__meta" data-out-meta aria-live="polite">
              <span data-meta-batches>—</span>
              <span class="forecast__meta-sep" aria-hidden="true">·</span>
              <span data-meta-rft>—</span>
              <span class="forecast__meta-sep" aria-hidden="true">·</span>
              <span class="forecast__meta-avoided">{f.avoidedPrefix}<span data-meta-avoided>—</span>{f.avoidedSuffix}</span>
            </p>

            <div
              class="forecast__range"
              role="radiogroup"
              aria-label={f.rangeAria}
              data-scenario-group
            >
              <button
                type="button"
                class="forecast__range-card"
                data-scenario="conservative"
                role="radio"
                aria-checked="false"
                tabindex="-1"
              >
                <span class="forecast__range-label">{f.scenarioConservative}</span>
                <span class="forecast__range-value" data-out-conservative>$0</span>
              </button>
              <button
                type="button"
                class="forecast__range-card is-selected"
                data-scenario="expected"
                role="radio"
                aria-checked="true"
                tabindex="0"
              >
                <span class="forecast__range-label">{f.scenarioExpected}</span>
                <span class="forecast__range-value" data-out-expected>$0</span>
              </button>
              <button
                type="button"
                class="forecast__range-card"
                data-scenario="optimistic"
                role="radio"
                aria-checked="false"
                tabindex="-1"
              >
                <span class="forecast__range-label">{f.scenarioOptimistic}</span>
                <span class="forecast__range-value" data-out-optimistic>$0</span>
              </button>
            </div>

            <h3 class="forecast__subhead" data-breakdown-title>{f.breakdownTitle.replace("{label}", f.scenarioExpected)}</h3>
            <div class="forecast__breakdown-wrap">
              <div
                class="forecast__breakdown-stack"
                data-breakdown-stack
                aria-hidden="true"
                title={f.stackTitle}
              >
                <span class="forecast__breakdown-seg" data-stack="rework"></span>
                <span class="forecast__breakdown-seg" data-stack="dye"></span>
                <span class="forecast__breakdown-seg" data-stack="water"></span>
                <span class="forecast__breakdown-seg" data-stack="energy"></span>
                <span class="forecast__breakdown-seg" data-stack="time"></span>
              </div>
              <ul class="forecast__breakdown" aria-label={f.breakdownAria}>
                <li data-cat="rework">
                  <div class="forecast__breakdown-head">
                    <span class="forecast__breakdown-label">
                      <span class="forecast__breakdown-swatch" aria-hidden="true"></span>
                      {f.catRework}
                    </span>
                    <span class="forecast__breakdown-val" data-out-cat="rework">$0</span>
                  </div>
                  <div class="forecast__breakdown-track" aria-hidden="true">
                    <div class="forecast__breakdown-bar" data-bar="rework"></div>
                  </div>
                </li>
                <li data-cat="dye">
                  <div class="forecast__breakdown-head">
                    <span class="forecast__breakdown-label">
                      <span class="forecast__breakdown-swatch" aria-hidden="true"></span>
                      {f.catDye}
                    </span>
                    <span class="forecast__breakdown-val" data-out-cat="dye">$0</span>
                  </div>
                  <div class="forecast__breakdown-track" aria-hidden="true">
                    <div class="forecast__breakdown-bar" data-bar="dye"></div>
                  </div>
                </li>
                <li data-cat="water">
                  <div class="forecast__breakdown-head">
                    <span class="forecast__breakdown-label">
                      <span class="forecast__breakdown-swatch" aria-hidden="true"></span>
                      {f.catWater}
                    </span>
                    <span class="forecast__breakdown-val" data-out-cat="water">$0</span>
                  </div>
                  <div class="forecast__breakdown-track" aria-hidden="true">
                    <div class="forecast__breakdown-bar" data-bar="water"></div>
                  </div>
                </li>
                <li data-cat="energy">
                  <div class="forecast__breakdown-head">
                    <span class="forecast__breakdown-label">
                      <span class="forecast__breakdown-swatch" aria-hidden="true"></span>
                      {f.catEnergy}
                    </span>
                    <span class="forecast__breakdown-val" data-out-cat="energy">$0</span>
                  </div>
                  <div class="forecast__breakdown-track" aria-hidden="true">
                    <div class="forecast__breakdown-bar" data-bar="energy"></div>
                  </div>
                </li>
                <li data-cat="time">
                  <div class="forecast__breakdown-head">
                    <span class="forecast__breakdown-label">
                      <span class="forecast__breakdown-swatch" aria-hidden="true"></span>
                      {f.catTime}
                    </span>
                    <span class="forecast__breakdown-val" data-out-cat="time">$0</span>
                  </div>
                  <div class="forecast__breakdown-track" aria-hidden="true">
                    <div class="forecast__breakdown-bar" data-bar="time"></div>
                  </div>
                </li>
              </ul>
            </div>

            <div class="forecast__method" data-method>
              <button
                type="button"
                class="forecast__method-toggle"
                data-method-toggle
                aria-expanded="false"
                aria-controls="forecast-method-panel"
                id="forecast-method-toggle"
              >
                <span class="forecast__method-summary-label">{f.methodToggle}</span>
                <span class="forecast__method-summary-hint">{f.methodHint}</span>
              </button>
              <div
                class="forecast__method-panel"
                id="forecast-method-panel"
                role="region"
                aria-labelledby="forecast-method-toggle"
                data-method-panel
              >
                <div class="forecast__method-panel-inner">
                  <div class="forecast__method-body">
                    <p class="forecast__method-lede">
                      {f.methodLede}
                    </p>

                    <p class="forecast__method-eq" data-method-rate>
                      {f.methodEqAnnual}
                      <span class="forecast__method-op">≈</span>
                      {f.methodEqBatches}
                      <span class="forecast__method-op">×</span>
                      {f.methodEqLift}
                      <span class="forecast__method-op">×</span>
                      {f.methodEqCost}
                    </p>

                    <div class="forecast__method-band-wrap">
                      <p class="forecast__method-band-caption">
                        {f.methodBandCaption}
                      </p>
                      <div
                        class="forecast__method-band"
                        data-method-reduction
                        role="list"
                        aria-label={f.methodBandAria}
                      >
                        <div class="forecast__method-band-item" role="listitem">
                          <span class="forecast__method-band-label">{f.scenarioConservative}</span>
                          <span class="forecast__method-band-val"
                            >{RFT_LIFT_REALIZATION.conservative}×</span
                          >
                          <span class="forecast__method-band-unit">{f.methodBandUnit}</span>
                        </div>
                        <div
                          class="forecast__method-band-item forecast__method-band-item--mid"
                          role="listitem"
                        >
                          <span class="forecast__method-band-label">{f.scenarioExpected}</span>
                          <span class="forecast__method-band-val"
                            >{RFT_LIFT_REALIZATION.expected}×</span
                          >
                          <span class="forecast__method-band-unit">{f.methodBandUnit}</span>
                        </div>
                        <div class="forecast__method-band-item" role="listitem">
