<script is:inline id="forecast-i18n" type="application/json" set:html={JSON.stringify({ locale, messages: f })} />
<script>
  import { initForecastWizard } from "../lib/forecast/wizard";
  import type { Locale } from "../i18n/locales";
  import type { ForecastMessages } from "../i18n/messages/types";

  const root = document.getElementById("forecast-wizard");
  const cfgEl = document.getElementById("forecast-i18n");
  if (root && cfgEl?.textContent) {
    try {
      const cfg = JSON.parse(cfgEl.textContent) as {
        locale?: Locale;
        messages?: ForecastMessages;
      };
      initForecastWizard(root, {
        locale: cfg.locale ?? "en",
        messages: cfg.messages,
      });
    } catch {
      initForecastWizard(root);
    }
  } else if (root) {
    initForecastWizard(root);
  }
</script>

