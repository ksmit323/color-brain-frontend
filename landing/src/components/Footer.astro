---
/**
 * Footer: brand, site links, founders, contact.
 * Locale-aware section links so the footer works on EN and ZH routes.
 */
import type { Locale } from "../i18n/locales";
import { getMessages } from "../i18n/messages";
import { forecastHref, homeHref, sectionHref } from "../i18n/paths";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const m = getMessages(locale);

const LINKS = [
  { href: sectionHref(locale, "#how-it-works"), label: m.nav.howItWorks },
  { href: sectionHref(locale, "#proof"), label: m.nav.proof },
  { href: sectionHref(locale, "#case-studies"), label: m.nav.caseStudies },
  { href: sectionHref(locale, "#who-its-for"), label: m.nav.whoItsFor },
  { href: forecastHref(locale), label: m.nav.forecast },
  { href: sectionHref(locale, "#contact"), label: m.common.requestPilot },
  { href: "https://app.colorbrain.co", label: m.common.openApp },
];

const FOUNDERS = [
  { name: "Luis Aloma", role: m.footer.roleCeo },
  { name: "Will Sandman", role: m.footer.roleCommercial },
  { name: "Ken Smith", role: m.footer.roleTechnical },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a class="footer__logo" href={homeHref(locale)}>
        <img src="/cb_logo.svg" alt="" width="30" height="31" />
        <span>{m.common.brand}</span>
      </a>
      <p class="footer__tagline">
        {m.footer.tagline}
      </p>
    </div>

    <nav class="footer__col" aria-label={m.footer.site}>
      <p class="footer__col-title">{m.footer.site}</p>
      <ul>
        {LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer__col">
      <p class="footer__col-title">{m.footer.founders}</p>
      <ul>
        {
          FOUNDERS.map((f) => (
            <li>
              <span class="footer__name">{f.name}</span>
              <span class="footer__role">{f.role}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <span>{m.footer.copyright}</span>
    <a href="mailto:luis@colorbrain.co">luis@colorbrain.co</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line-soft);
    padding-block: 4rem 2rem;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2.5rem;
  }

  @media (max-width: 720px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
  }

  .footer__tagline {
    margin-top: 1rem;
    color: var(--ink-faint);
    font-size: 0.9rem;
    max-width: 34ch;
  }

  .footer__col-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .footer__col ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer__col a {
    color: var(--ink-dim);
    text-decoration: none;
  }

  .footer__col a:hover {
    color: var(--ink);
  }

  .footer__name {
    display: block;
    color: var(--ink-dim);
  }

  .footer__role {
    display: block;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-soft);
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  .footer__bottom a {
    color: var(--ink-dim);
  }
</style>
