---
/**
 * The cost of guessing — why first-attempt accuracy matters.
 */
import type { Locale } from "../i18n/locales";
import { getMessages } from "../i18n/messages";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const m = getMessages(locale);
---

<section class="problem stage-panel section" id="problem">
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">{m.problem.eyebrow}</p>
      <h2 class="title">
        {m.problem.title}
      </h2>
      <p class="lede">
        {m.problem.lede}
      </p>
    </div>
    <dl class="problem__readouts reveal">
      <div>
        <span class="problem__index">{m.problem.indexAttempts}</span>
        <dt class="readout__value">4–6</dt>
        <dd class="readout__label">{m.problem.labelAttempts}</dd>
      </div>
      <div>
        <span class="problem__index">{m.problem.indexFailure}</span>
        <dt class="readout__value">50%</dt>
        <dd class="readout__label">{m.problem.labelFailure}</dd>
      </div>
      <div>
        <span class="problem__index">{m.problem.indexCost}</span>
        <dt class="readout__value">$500–2K</dt>
        <dd class="readout__label">{m.problem.labelCost}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .problem {
    overflow: hidden;
    background:
      radial-gradient(circle at 86% 18%, rgba(224, 108, 117, 0.07), transparent 28rem),
      var(--surface);
  }

  .problem::after {
    content: "";
    position: absolute;
    top: -10rem;
    right: 7vw;
    width: 28rem;
    height: 28rem;
    border: 1px solid rgba(224, 108, 117, 0.09);
    border-radius: 50%;
    box-shadow:
      0 0 0 5rem rgba(224, 108, 117, 0.018),
      0 0 0 10rem rgba(224, 108, 117, 0.012);
  }

  .problem .container {
    position: relative;
    z-index: 1;
  }

  .problem__readouts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1px;
    margin-top: 4rem;
    border-block: 1px solid var(--line);
    background: var(--line);
  }

  .problem__readouts > div {
    min-height: 13rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.6rem;
    background: var(--surface);
  }

  .problem__index {
    margin-bottom: auto;
    font-family: var(--font-mono);
    font-size: 0.61rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--fail);
  }

  .problem__readouts dd {
    margin: 0;
  }
</style>
