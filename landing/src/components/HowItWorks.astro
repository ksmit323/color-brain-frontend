---
/**
 * How it works: five steps timed to the constellation scroll narrative.
 */
import type { Locale } from "../i18n/locales";
import { getMessages } from "../i18n/messages";

type StepTone = "neutral" | "win" | "loop";
type StepBeat = "connect" | "search" | "match" | "adjust" | "learn";

interface StepItem {
  beat: StepBeat;
  num: string;
  state: string;
  title: string;
  body: string;
  tone: StepTone;
}

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const m = getMessages(locale);

const steps: StepItem[] = [
  {
    beat: "connect",
    num: "01",
    state: m.how.step1State,
    title: m.how.step1Title,
    body: m.how.step1Body,
    tone: "neutral",
  },
  {
    beat: "search",
    num: "02",
    state: m.how.step2State,
    title: m.how.step2Title,
    body: m.how.step2Body,
    tone: "neutral",
  },
  {
    beat: "match",
    num: "03",
    state: m.how.step3State,
    title: m.how.step3Title,
    body: m.how.step3Body,
    tone: "win",
  },
  {
    beat: "adjust",
    num: "04",
    state: m.how.step4State,
    title: m.how.step4Title,
    body: m.how.step4Body,
    tone: "neutral",
  },
  {
    beat: "learn",
    num: "05",
    state: m.how.step5State,
    title: m.how.step5Title,
    body: m.how.step5Body,
    tone: "loop",
  },
];
---

<section class="how" id="how-it-works">
  <div class="container">
    <div class="how__head reveal">
      <p class="eyebrow">{m.how.eyebrow}</p>
      <h2 class="title">{m.how.title}</h2>
      <p class="lede">
        {m.how.lede}
      </p>
    </div>

    <ol class="how__steps">
      {
        steps.map((s) => (
          <li class="how__step reveal" data-beat={s.beat}>
            <div class="how__step-top">
              <span class="how__num">{s.num}</span>
              <span
                class:list={[
                  "how__state",
                  {
                    "how__state--win": s.tone === "win",
                    "how__state--loop": s.tone === "loop",
                  },
                ]}
              >
                {s.state}
              </span>
            </div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how {
    position: relative;
    padding-bottom: 15vh;
  }

  .how::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0 38% 0 0;
    background: linear-gradient(90deg, rgba(7, 8, 12, 0.98) 68%, transparent);
    pointer-events: none;
  }

  .how__head {
    min-height: 48vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    max-width: 31rem;
    padding-bottom: 5rem;
  }

  .how__steps {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .how__steps::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--line) 8%, var(--line) 92%, transparent);
  }

  .how__step {
    min-height: 68svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 30rem;
    padding: 2rem 2rem 2rem 2.25rem;
    border-left: 1px solid transparent;
  }

  .how__step-top {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .how__num,
  .how__state {
    font-family: var(--font-mono);
    font-size: 0.67rem;
    color: var(--ink-faint);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .how__num {
    position: relative;
    color: var(--ink-dim);
  }

  .how__num::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -2.55rem;
    width: 0.58rem;
    height: 0.58rem;
    border: 1px solid var(--ink-faint);
    background: var(--bg);
    transform: translateY(-50%) rotate(45deg);
  }

  .how__state {
    padding: 0.25em 0.6em;
    border: 1px solid var(--line);
    border-radius: 3px;
  }

  .how__state--win {
    border-color: rgba(70, 199, 154, 0.35);
    color: var(--win);
  }

  .how__state--loop {
    border-color: rgba(127, 216, 232, 0.4);
    color: var(--holo);
  }

  .how__step h3 {
    max-width: 14ch;
    margin-top: 1rem;
    font-size: clamp(1.65rem, 2.7vw, 2.25rem);
  }

  .how__step p {
    max-width: 29rem;
    color: var(--ink-dim);
    margin-top: 1rem;
  }

  @media (max-width: 720px) {
    .how {
      padding-bottom: 5rem;
    }

    .how::before {
      right: 0;
      background: rgba(7, 8, 12, 0.58);
    }

    .how__head {
      min-height: 58svh;
    }

    .how__step {
      min-height: 62svh;
      max-width: 27rem;
      padding-right: 0.5rem;
    }
  }
</style>
