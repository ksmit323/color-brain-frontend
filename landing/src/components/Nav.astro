---
/**
 * Floating glass navigation pill. Middle links collapse on small screens;
 * language control stays in nav__actions so it remains visible on mobile (R6).
 */
import type { Locale } from "../i18n/locales";
import {
  otherLocale,
  LOCALE_LABELS,
  LOCALE_HREFLANG,
} from "../i18n/locales";
import { getMessages } from "../i18n/messages";
import {
  counterpartPath,
  forecastHref,
  homeHref,
  isForecastPath,
  isHomePath,
  sectionHref,
} from "../i18n/paths";

interface Props {
  locale?: Locale;
  /** Current path for active nav state, e.g. "/" or "/zh/forecast". */
  path?: string;
}
const { locale = "en", path = "/" } = Astro.props;
const m = getMessages(locale);
const isHome = isHomePath(path, locale);
const isForecast = isForecastPath(path, locale);
const section = (hash: string) =>
  sectionHref(locale, hash, { onHome: isHome });
const brandHref = isHome ? "#top" : homeHref(locale);
const pilotHref = section("#contact");
const forecastPath = forecastHref(locale);
const alt = otherLocale(locale);
const langHref = counterpartPath(path, locale);
const langLabel = LOCALE_LABELS[alt];
const langAria = alt === "zh" ? m.nav.switchToZh : m.nav.switchToEn;
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href={brandHref}>
      <img src="/cb_logo.svg" alt="" width="26" height="27" />
      <span>{m.common.brand}</span>
      <em>AI</em>
    </a>
    <nav class="nav__links" aria-label={m.common.siteNavAria}>
      <a href={section("#how-it-works")}>{m.nav.howItWorks}</a>
      <a href={section("#proof")}>{m.nav.proof}</a>
      <a href={section("#case-studies")}>{m.nav.caseStudies}</a>
      <a href={section("#who-its-for")}>{m.nav.whoItsFor}</a>
      <a
        href={forecastPath}
        class:list={[{ "is-active": isForecast }]}
        aria-current={isForecast ? "page" : undefined}
      >{m.nav.forecast}</a>
    </nav>
    <div class="nav__actions">
      <a
        class="nav__lang"
        href={langHref}
        data-locale-switch
        data-locale-target={alt}
        hreflang={LOCALE_HREFLANG[alt]}
        aria-label={langAria}
        title={langAria}
      >{langLabel}</a>
      <a class="nav__ghost" href="https://app.colorbrain.co">{m.common.openApp}</a>
      <a class="btn btn--primary nav__cta" href={pilotHref}>{m.common.requestPilot}</a>
    </div>
  </div>
</header>

<script>
  import { writePreferenceCookie } from "../i18n/preference";
  import { isLocale } from "../i18n/locales";

  document.querySelectorAll("[data-locale-switch]").forEach((el) => {
    el.addEventListener("click", () => {
      const target = el.getAttribute("data-locale-target");
      if (isLocale(target)) writePreferenceCookie(target);
    });
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0.75rem;
    z-index: 10;
    margin-inline: max(0.75rem, calc((100vw - var(--container)) / 2));
    border: 1px solid color-mix(in srgb, var(--holo) 14%, rgba(41, 46, 58, 0.66));
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 68%, transparent);
    backdrop-filter: blur(20px) saturate(1.3);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    box-shadow:
      0 14px 42px rgba(0, 0, 0, 0.38),
      inset 0 1px 0 rgba(127, 216, 232, 0.07);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
  }

  .nav__brand img {
    filter: drop-shadow(0 0 12px rgba(237, 238, 244, 0.14));
  }

  .nav__brand em {
    padding: 0.22em 0.42em;
    border: 1px solid var(--line);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.53rem;
    font-style: normal;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
  }

  .nav__links {
    display: flex;
    gap: 1.75rem;
  }

  .nav__links a {
    position: relative;
    font-size: 0.9rem;
    color: var(--ink-dim);
    text-decoration: none;
    transition:
      color 160ms ease,
      text-shadow 160ms ease;
  }

  .nav__links a::before {
    content: ">";
    position: absolute;
    left: -0.85em;
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--holo);
    opacity: 0;
    transform: translateX(-3px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .nav__links a:hover,
  .nav__links a.is-active {
    color: var(--ink);
    text-shadow: 0 0 14px rgba(127, 216, 232, 0.35);
  }

  .nav__links a:hover::before,
  .nav__links a.is-active::before {
    opacity: 1;
    transform: none;
  }

  .nav__links a.is-active {
    color: var(--holo);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .nav__lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.4rem;
    min-height: 2.1rem;
    padding: 0.35em 0.55em;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
    text-decoration: none;
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .nav__lang:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
    background: rgba(127, 216, 232, 0.06);
  }

  .nav__ghost {
    font-size: 0.9rem;
    color: var(--ink-dim);
    text-decoration: none;
  }

  .nav__ghost:hover {
    color: var(--ink);
  }

  .nav__cta {
    min-height: 2.35rem;
    padding: 0.5em 1.1em;
    font-size: 0.67rem;
  }

  @media (max-width: 860px) {
    .nav__links,
    .nav__ghost {
      display: none;
    }

    .nav {
      margin-inline: 0.5rem;
    }

    .nav__inner {
      gap: 0.65rem;
      padding-inline: 0.75rem;
    }

    .nav__actions {
      gap: 0.55rem;
    }

    .nav__brand span,
    .nav__cta {
      white-space: nowrap;
    }

    .nav__lang {
      min-width: 2.2rem;
      min-height: 2rem;
      font-size: 0.64rem;
    }

    .nav__cta {
      font-size: 0.62rem;
      padding: 0.5em 0.85em;
    }
  }
</style>
