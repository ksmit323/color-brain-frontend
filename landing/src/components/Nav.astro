---
/**
 * Floating glass navigation pill. Middle links collapse on small screens;
 * language control stays far-right in nav__actions (visible on mobile).
 *
 * Dropdown lists live locales plus any planned placeholders (disabled
 * until those catalogs and routes ship).
 */
import type { Locale } from "../i18n/locales";
import {
  LOCALE_HREFLANG,
  LOCALE_LABELS,
  LOCALE_MENU,
} from "../i18n/locales";
import { getMessages } from "../i18n/messages";
import {
  counterpartPath,
  forecastHref,
  homeHref,
  isForecastPath,
  isHomePath,
  sectionHref,
} from "../i18n/paths";

interface Props {
  locale?: Locale;
  /** Current path for active nav state, e.g. "/" or "/zh/calculator". */
  path?: string;
}
const { locale = "en", path = "/" } = Astro.props;
const m = getMessages(locale);
const isHome = isHomePath(path, locale);
const isForecast = isForecastPath(path, locale);
const section = (hash: string) =>
  sectionHref(locale, hash, { onHome: isHome });
const brandHref = isHome ? "#top" : homeHref(locale);
const pilotHref = section("#contact");
const forecastPath = forecastHref(locale);
const currentLabel = LOCALE_LABELS[locale];
const langMenuId = "nav-lang-menu";
const comingSoon = m.nav.comingSoon;
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href={brandHref}>
      <img src="/cb_logo.svg" alt="" width="26" height="27" />
      <span>{m.common.brand}</span>
      <em>AI</em>
    </a>
    <nav class="nav__links" aria-label={m.common.siteNavAria}>
      <a href={section("#how-it-works")}>{m.nav.howItWorks}</a>
      <a href={section("#proof")}>{m.nav.proof}</a>
      <a href={section("#case-studies")}>{m.nav.caseStudies}</a>
      <a href={section("#who-its-for")}>{m.nav.whoItsFor}</a>
      <a
        href={forecastPath}
        class:list={[{ "is-active": isForecast }]}
        aria-current={isForecast ? "page" : undefined}
      >{m.nav.forecast}</a>
    </nav>
    <div class="nav__actions">
      <a class="nav__ghost" href="https://app.colorbrain.co">{m.common.openApp}</a>
      <a class="btn btn--primary nav__cta" href={pilotHref}>{m.common.requestPilot}</a>

      <div class="nav__lang" data-lang-root>
        <button
          type="button"
          class="nav__lang-trigger"
          data-lang-trigger
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls={langMenuId}
          aria-label={m.nav.langAria}
        >
          <i class="nav__lang-bracket nav__lang-bracket--tl" aria-hidden="true"></i>
          <i class="nav__lang-bracket nav__lang-bracket--tr" aria-hidden="true"></i>
          <i class="nav__lang-bracket nav__lang-bracket--bl" aria-hidden="true"></i>
          <i class="nav__lang-bracket nav__lang-bracket--br" aria-hidden="true"></i>
          <span class="nav__lang-code">{currentLabel}</span>
          <span class="nav__lang-chevron" aria-hidden="true"></span>
        </button>
        <div
          class="nav__lang-menu"
          id={langMenuId}
          role="listbox"
          aria-label={m.nav.langAria}
          hidden
          data-lang-menu
        >
          <div class="nav__lang-scan" aria-hidden="true"></div>
          <div class="nav__lang-menu-head" aria-hidden="true">
            <span>// LANGUAGE</span>
            <span class="nav__lang-menu-status">ONLINE</span>
          </div>
          {LOCALE_MENU.map((entry) => {
            const active = entry.live && entry.id === locale;
            if (!entry.live) {
              return (
                <span
                  class="nav__lang-opt is-placeholder"
                  role="option"
                  aria-selected="false"
                  aria-disabled="true"
                  title={comingSoon}
                >
                  <span class="nav__lang-opt-mark" aria-hidden="true">·</span>
                  <span class="nav__lang-opt-code">{entry.label}</span>
                  <span class="nav__lang-opt-name">
                    {entry.name}
                    <em class="nav__lang-soon">{comingSoon}</em>
                  </span>
                </span>
              );
            }
            if (active) {
              return (
                <span
                  class="nav__lang-opt is-active"
                  role="option"
                  aria-selected="true"
                >
                  <span class="nav__lang-opt-mark" aria-hidden="true">&gt;</span>
                  <span class="nav__lang-opt-code">{entry.label}</span>
                  <span class="nav__lang-opt-name">{entry.name}</span>
                </span>
              );
            }
            const target = entry.id as Locale;
            const href = counterpartPath(path, locale, target);
            return (
              <a
                class="nav__lang-opt"
                role="option"
                aria-selected="false"
                href={href}
                hreflang={LOCALE_HREFLANG[target]}
                data-locale-switch
                data-locale-target={target}
                title={entry.name}
              >
                <span class="nav__lang-opt-mark" aria-hidden="true">&gt;</span>
                <span class="nav__lang-opt-code">{entry.label}</span>
                <span class="nav__lang-opt-name">{entry.name}</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { writePreferenceCookie } from "../i18n/preference";
  import { isLocale } from "../i18n/locales";

  document.querySelectorAll("[data-locale-switch]").forEach((el) => {
    el.addEventListener("click", () => {
      const target = el.getAttribute("data-locale-target");
      if (isLocale(target)) writePreferenceCookie(target);
    });
  });

  document.querySelectorAll("[data-lang-root]").forEach((root) => {
    const trigger = root.querySelector("[data-lang-trigger]");
    const menu = root.querySelector("[data-lang-menu]");
    if (!(trigger instanceof HTMLElement) || !(menu instanceof HTMLElement)) return;

    const setOpen = (open: boolean) => {
      trigger.setAttribute("aria-expanded", open ? "true" : "false");
      menu.hidden = !open;
      root.classList.toggle("is-open", open);
    };

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(menu.hidden);
    });

    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) setOpen(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0.75rem;
    z-index: 10;
    margin-inline: max(0.75rem, calc((100vw - var(--container)) / 2));
    border: 1px solid color-mix(in srgb, var(--holo) 14%, rgba(41, 46, 58, 0.66));
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 68%, transparent);
    backdrop-filter: blur(20px) saturate(1.3);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    box-shadow:
      0 14px 42px rgba(0, 0, 0, 0.38),
      inset 0 1px 0 rgba(127, 216, 232, 0.07);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
  }

  .nav__brand img {
    filter: drop-shadow(0 0 12px rgba(237, 238, 244, 0.14));
  }

  .nav__brand em {
    padding: 0.22em 0.42em;
    border: 1px solid var(--line);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.53rem;
    font-style: normal;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
  }

  .nav__links {
    display: flex;
    gap: 1.75rem;
  }

  .nav__links a {
    position: relative;
    font-size: 0.9rem;
    color: var(--ink-dim);
    text-decoration: none;
    transition:
      color 160ms ease,
      text-shadow 160ms ease;
  }

  .nav__links a::before {
    content: ">";
    position: absolute;
    left: -0.85em;
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--holo);
    opacity: 0;
    transform: translateX(-3px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .nav__links a:hover,
  .nav__links a.is-active {
    color: var(--ink);
    text-shadow: 0 0 14px rgba(127, 216, 232, 0.35);
  }

  .nav__links a:hover::before,
  .nav__links a.is-active::before {
    opacity: 1;
    transform: none;
  }

  .nav__links a.is-active {
    color: var(--holo);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-left: auto;
  }

  /* ── Multi-locale HUD control (far right) ─────────────────────────── */

  .nav__lang {
    --lang-holo: var(--holo);
    position: relative;
    flex-shrink: 0;
    z-index: 20;
  }

  .nav__lang-trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0.32rem 0.7rem 0.32rem 0.55rem;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid color-mix(in srgb, var(--lang-holo) 42%, var(--line));
    border-radius: 4px;
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--lang-holo) 14%, #0a0c12) 0%,
        #07090f 48%,
        #05070c 100%
      );
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.55),
      0 0 20px rgba(127, 216, 232, 0.12),
      inset 0 1px 0 rgba(127, 216, 232, 0.22),
      inset 0 -10px 18px rgba(0, 0, 0, 0.35);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  /* Fine scanline texture */
  .nav__lang-trigger::after {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 2px,
      rgba(127, 216, 232, 0.035) 2px 3px
    );
    opacity: 0.7;
    pointer-events: none;
    z-index: 0;
  }

  .nav__lang-trigger:hover,
  .nav__lang.is-open .nav__lang-trigger {
    border-color: color-mix(in srgb, var(--lang-holo) 72%, white);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.55),
      0 0 28px rgba(127, 216, 232, 0.28),
      0 0 2px color-mix(in srgb, var(--lang-holo) 80%, transparent),
      inset 0 1px 0 rgba(180, 240, 250, 0.35),
      inset 0 -10px 18px rgba(0, 0, 0, 0.3);
    transform: translateY(-1px);
  }

  .nav__lang.is-open .nav__lang-trigger {
    border-bottom-color: color-mix(in srgb, var(--lang-holo) 30%, transparent);
  }

  .nav__lang-trigger:focus-visible {
    outline: 1px solid color-mix(in srgb, var(--lang-holo) 80%, transparent);
    outline-offset: 3px;
  }

  /* Corner reticle brackets (loader-adjacent HUD) */
  .nav__lang-bracket {
    position: absolute;
    width: 0.42rem;
    height: 0.42rem;
    z-index: 2;
    pointer-events: none;
    opacity: 0.85;
  }

  .nav__lang-bracket--tl {
    top: 3px;
    left: 3px;
    border-top: 1.5px solid var(--lang-holo);
    border-left: 1.5px solid var(--lang-holo);
    box-shadow: -1px -1px 6px rgba(127, 216, 232, 0.35);
  }

  .nav__lang-bracket--tr {
    top: 3px;
    right: 3px;
    border-top: 1.5px solid var(--lang-holo);
    border-right: 1.5px solid var(--lang-holo);
    box-shadow: 1px -1px 6px rgba(127, 216, 232, 0.35);
  }

  .nav__lang-bracket--bl {
    bottom: 3px;
    left: 3px;
    border-bottom: 1.5px solid var(--lang-holo);
    border-left: 1.5px solid var(--lang-holo);
    box-shadow: -1px 1px 6px rgba(127, 216, 232, 0.35);
  }

  .nav__lang-bracket--br {
    bottom: 3px;
    right: 3px;
    border-bottom: 1.5px solid var(--lang-holo);
    border-right: 1.5px solid var(--lang-holo);
    box-shadow: 1px 1px 6px rgba(127, 216, 232, 0.35);
  }

  .nav__lang-code {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #e8fcff;
    text-shadow:
      0 0 10px rgba(127, 216, 232, 0.65),
      0 0 22px rgba(127, 216, 232, 0.25);
  }

  .nav__lang-chevron {
    position: relative;
    z-index: 1;
    width: 0.4rem;
    height: 0.4rem;
    margin-left: 0.05rem;
    border-right: 1.5px solid var(--lang-holo);
    border-bottom: 1.5px solid var(--lang-holo);
    transform: rotate(45deg) translateY(-1px);
    opacity: 0.9;
    filter: drop-shadow(0 0 4px rgba(127, 216, 232, 0.6));
    transition: transform 180ms ease;
  }

  .nav__lang.is-open .nav__lang-chevron {
    transform: rotate(225deg) translateY(-1px);
  }

  .nav__lang-menu {
    position: absolute;
    top: calc(100% + 0.45rem);
    right: 0;
    min-width: 12.25rem;
    padding: 0.4rem;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid color-mix(in srgb, var(--lang-holo) 38%, var(--line));
    background:
      linear-gradient(
        165deg,
        color-mix(in srgb, #10141c 88%, var(--lang-holo)) 0%,
        #07090f 55%,
        #05070c 100%
      );
    backdrop-filter: blur(20px) saturate(1.35);
    -webkit-backdrop-filter: blur(20px) saturate(1.35);
    box-shadow:
      0 22px 48px rgba(0, 0, 0, 0.62),
      0 0 0 1px rgba(0, 0, 0, 0.5),
      0 0 32px rgba(127, 216, 232, 0.12),
      inset 0 1px 0 rgba(127, 216, 232, 0.14);
  }

  .nav__lang-menu[hidden] {
    display: none;
  }

  .nav__lang-scan {
    position: absolute;
    left: 0;
    right: 0;
    top: -30%;
    height: 35%;
    background: linear-gradient(
      180deg,
      transparent,
      color-mix(in srgb, var(--lang-holo) 16%, transparent),
      transparent
    );
    pointer-events: none;
    animation: nav-lang-scan 2.8s linear infinite;
    opacity: 0.7;
  }

  .nav__lang-menu-head {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
    padding: 0.28rem 0.45rem 0.4rem;
    border-bottom: 1px solid color-mix(in srgb, var(--lang-holo) 18%, transparent);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--lang-holo) 70%, var(--ink-faint));
  }

  .nav__lang-menu-status {
    color: var(--lang-holo);
    text-shadow: 0 0 8px rgba(127, 216, 232, 0.55);
    animation: nav-lang-pulse 1.8s ease-in-out infinite;
  }

  .nav__lang-opt {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 0.7rem 2rem 1fr;
    align-items: center;
    gap: 0.35rem 0.45rem;
    width: 100%;
    padding: 0.5rem 0.5rem;
    border-radius: 4px;
    text-decoration: none;
    color: var(--ink-dim);
    transition:
      color 140ms ease,
      background-color 140ms ease,
      box-shadow 140ms ease,
      text-shadow 140ms ease;
  }

  .nav__lang-opt-mark {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--lang-holo);
    opacity: 0;
    transform: translateX(-3px);
    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }

  a.nav__lang-opt:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--lang-holo) 9%, transparent);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--lang-holo) 22%, transparent),
      0 0 16px rgba(127, 216, 232, 0.08);
    text-shadow: 0 0 12px rgba(127, 216, 232, 0.2);
  }

  a.nav__lang-opt:hover .nav__lang-opt-mark {
    opacity: 1;
    transform: none;
  }

  .nav__lang-opt.is-active {
    color: #041016;
    background:
      linear-gradient(
        100deg,
        color-mix(in srgb, var(--lang-holo) 95%, white) 0%,
        var(--lang-holo) 42%,
        color-mix(in srgb, var(--lang-holo) 72%, #2a8a9a) 100%
      );
    box-shadow:
      0 0 18px rgba(127, 216, 232, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .nav__lang-opt.is-active .nav__lang-opt-mark {
    opacity: 1;
    transform: none;
    color: #041016;
    text-shadow: none;
  }

  .nav__lang-opt-code {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .nav__lang-opt-name {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.12rem;
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    line-height: 1.15;
    opacity: 0.95;
  }

  .nav__lang-opt.is-active .nav__lang-opt-name {
    opacity: 0.9;
  }

  .nav__lang-opt.is-placeholder {
    opacity: 0.38;
    cursor: not-allowed;
    pointer-events: none;
  }

  .nav__lang-opt.is-placeholder .nav__lang-opt-mark {
    opacity: 0.5;
  }

  .nav__lang-soon {
    font-family: var(--font-mono);
    font-size: 0.52rem;
    font-style: normal;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  @keyframes nav-lang-scan {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(380%);
    }
  }

  @keyframes nav-lang-pulse {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__lang-scan,
    .nav__lang-menu-status {
      animation: none;
    }
  }

  .nav__ghost {
    font-size: 0.9rem;
    color: var(--ink-dim);
    text-decoration: none;
  }

  .nav__ghost:hover {
    color: var(--ink);
  }

  .nav__cta {
    min-height: 2.35rem;
    padding: 0.5em 1.1em;
    font-size: 0.67rem;
  }

  @media (max-width: 860px) {
    .nav__links,
    .nav__ghost {
      display: none;
    }

    .nav {
      margin-inline: 0.5rem;
    }

    .nav__inner {
      gap: 0.55rem;
      padding-inline: 0.65rem;
    }

    .nav__actions {
      gap: 0.45rem;
    }

    .nav__brand span,
    .nav__cta {
      white-space: nowrap;
    }

    .nav__lang-trigger {
      min-height: 2.05rem;
      gap: 0.4rem;
      padding: 0.28rem 0.55rem 0.28rem 0.45rem;
    }

    .nav__lang-code {
      font-size: 0.64rem;
      letter-spacing: 0.12em;
    }

    .nav__lang-menu {
      min-width: 11rem;
    }

    .nav__cta {
      font-size: 0.62rem;
      padding: 0.5em 0.85em;
    }
  }
</style>
