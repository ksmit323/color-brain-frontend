---
/**
 * Floating glass navigation pill. Middle links collapse on small screens;
 * language control stays in nav__actions so it remains visible on mobile (R6).
 */
import type { Locale } from "../i18n/locales";
import { otherLocale, LOCALE_HREFLANG } from "../i18n/locales";
import { getMessages } from "../i18n/messages";
import {
  counterpartPath,
  forecastHref,
  homeHref,
  isForecastPath,
  isHomePath,
  sectionHref,
} from "../i18n/paths";

interface Props {
  locale?: Locale;
  /** Current path for active nav state, e.g. "/" or "/zh/forecast". */
  path?: string;
}
const { locale = "en", path = "/" } = Astro.props;
const m = getMessages(locale);
const isHome = isHomePath(path, locale);
const isForecast = isForecastPath(path, locale);
const section = (hash: string) =>
  sectionHref(locale, hash, { onHome: isHome });
const brandHref = isHome ? "#top" : homeHref(locale);
const pilotHref = section("#contact");
const forecastPath = forecastHref(locale);
const alt = otherLocale(locale);
const langHref = counterpartPath(path, locale);
const langAria = alt === "zh" ? m.nav.switchToZh : m.nav.switchToEn;
const langGroupAria = locale === "zh" ? "语言" : "Language";
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href={brandHref}>
      <img src="/cb_logo.svg" alt="" width="26" height="27" />
      <span>{m.common.brand}</span>
      <em>AI</em>
    </a>
    <nav class="nav__links" aria-label={m.common.siteNavAria}>
      <a href={section("#how-it-works")}>{m.nav.howItWorks}</a>
      <a href={section("#proof")}>{m.nav.proof}</a>
      <a href={section("#case-studies")}>{m.nav.caseStudies}</a>
      <a href={section("#who-its-for")}>{m.nav.whoItsFor}</a>
      <a
        href={forecastPath}
        class:list={[{ "is-active": isForecast }]}
        aria-current={isForecast ? "page" : undefined}
      >{m.nav.forecast}</a>
    </nav>
    <div class="nav__actions">
      <a class="nav__ghost" href="https://app.colorbrain.co">{m.common.openApp}</a>
      <a class="btn btn--primary nav__cta" href={pilotHref}>{m.common.requestPilot}</a>
      {/* Far-right segmented locale control — current locale inert, other is switch */}
      <div class="nav__lang" role="group" aria-label={langGroupAria}>
        {locale === "en" ? (
          <span class="nav__lang-opt is-active" aria-current="true">
            <span class="nav__lang-code">EN</span>
          </span>
        ) : (
          <a
            class="nav__lang-opt"
            href={langHref}
            data-locale-switch
            data-locale-target="en"
            hreflang={LOCALE_HREFLANG.en}
            aria-label={m.nav.switchToEn}
            title={m.nav.switchToEn}
          >
            <span class="nav__lang-code">EN</span>
          </a>
        )}
        <span class="nav__lang-divider" aria-hidden="true"></span>
        {locale === "zh" ? (
          <span class="nav__lang-opt is-active" aria-current="true">
            <span class="nav__lang-code">中文</span>
          </span>
        ) : (
          <a
            class="nav__lang-opt"
            href={langHref}
            data-locale-switch
            data-locale-target="zh"
            hreflang={LOCALE_HREFLANG.zh}
            aria-label={langAria}
            title={langAria}
          >
            <span class="nav__lang-code">中文</span>
          </a>
        )}
      </div>
    </div>
  </div>
</header>

<script>
  import { writePreferenceCookie } from "../i18n/preference";
  import { isLocale } from "../i18n/locales";

  document.querySelectorAll("[data-locale-switch]").forEach((el) => {
    el.addEventListener("click", () => {
      const target = el.getAttribute("data-locale-target");
      if (isLocale(target)) writePreferenceCookie(target);
    });
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0.75rem;
    z-index: 10;
    margin-inline: max(0.75rem, calc((100vw - var(--container)) / 2));
    border: 1px solid color-mix(in srgb, var(--holo) 14%, rgba(41, 46, 58, 0.66));
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 68%, transparent);
    backdrop-filter: blur(20px) saturate(1.3);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    box-shadow:
      0 14px 42px rgba(0, 0, 0, 0.38),
      inset 0 1px 0 rgba(127, 216, 232, 0.07);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
  }

  .nav__brand img {
    filter: drop-shadow(0 0 12px rgba(237, 238, 244, 0.14));
  }

  .nav__brand em {
    padding: 0.22em 0.42em;
    border: 1px solid var(--line);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.53rem;
    font-style: normal;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
  }

  .nav__links {
    display: flex;
    gap: 1.75rem;
  }

  .nav__links a {
    position: relative;
    font-size: 0.9rem;
    color: var(--ink-dim);
    text-decoration: none;
    transition:
      color 160ms ease,
      text-shadow 160ms ease;
  }

  .nav__links a::before {
    content: ">";
    position: absolute;
    left: -0.85em;
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--holo);
    opacity: 0;
    transform: translateX(-3px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .nav__links a:hover,
  .nav__links a.is-active {
    color: var(--ink);
    text-shadow: 0 0 14px rgba(127, 216, 232, 0.35);
  }

  .nav__links a:hover::before,
  .nav__links a.is-active::before {
    opacity: 1;
    transform: none;
  }

  .nav__links a.is-active {
    color: var(--holo);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    /* Lang control stays trailing (far right) even if actions reflow. */
    margin-left: auto;
  }

  .nav__lang {
    --lang-pad-y: 0.28rem;
    --lang-pad-x: 0.22rem;
    position: relative;
    display: inline-flex;
    align-items: stretch;
    flex-shrink: 0;
    padding: var(--lang-pad-y) var(--lang-pad-x);
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--holo) 28%, var(--line));
    background:
      linear-gradient(
        155deg,
        color-mix(in srgb, var(--holo) 10%, transparent) 0%,
        rgba(10, 12, 18, 0.72) 48%,
        rgba(8, 10, 16, 0.88) 100%
      );
    box-shadow:
      inset 0 1px 0 rgba(127, 216, 232, 0.14),
      inset 0 0 0 1px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(0, 0, 0, 0.25),
      0 0 22px rgba(127, 216, 232, 0.08);
    isolation: isolate;
  }

  /* Soft holographic sweep across the shell */
  .nav__lang::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      105deg,
      transparent 0%,
      color-mix(in srgb, var(--holo) 14%, transparent) 42%,
      transparent 68%
    );
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
  }

  .nav__lang-opt {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.15rem;
    min-height: 1.75rem;
    padding: 0.15em 0.55em;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-faint);
    transition:
      color 180ms ease,
      text-shadow 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  a.nav__lang-opt {
    cursor: pointer;
  }

  a.nav__lang-opt:hover {
    color: var(--ink);
    text-shadow: 0 0 12px rgba(127, 216, 232, 0.45);
    background: color-mix(in srgb, var(--holo) 8%, transparent);
  }

  a.nav__lang-opt:focus-visible {
    outline: 1px solid color-mix(in srgb, var(--holo) 70%, transparent);
    outline-offset: 2px;
  }

  .nav__lang-opt.is-active {
    color: var(--bg);
    letter-spacing: 0.12em;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--holo) 92%, white) 0%,
        var(--holo) 55%,
        color-mix(in srgb, var(--holo) 78%, #3a9aaa) 100%
      );
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--holo) 55%, transparent),
      0 0 18px rgba(127, 216, 232, 0.42),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    text-shadow: none;
  }

  /* 中文 is denser — slightly tighter tracking so it fits the pill */
  .nav__lang-opt.is-active .nav__lang-code:lang(zh),
  .nav__lang-opt .nav__lang-code {
    letter-spacing: 0.08em;
  }

  .nav__lang-opt.is-active .nav__lang-code {
    letter-spacing: 0.1em;
  }

  .nav__lang-divider {
    position: relative;
    z-index: 1;
    align-self: center;
    width: 1px;
    height: 0.85rem;
    margin-inline: 0.08rem;
    background: linear-gradient(
      180deg,
      transparent,
      color-mix(in srgb, var(--holo) 45%, var(--line)) 30%,
      color-mix(in srgb, var(--holo) 45%, var(--line)) 70%,
      transparent
    );
    opacity: 0.75;
  }

  .nav__ghost {
    font-size: 0.9rem;
    color: var(--ink-dim);
    text-decoration: none;
  }

  .nav__ghost:hover {
    color: var(--ink);
  }

  .nav__cta {
    min-height: 2.35rem;
    padding: 0.5em 1.1em;
    font-size: 0.67rem;
  }

  @media (max-width: 860px) {
    .nav__links,
    .nav__ghost {
      display: none;
    }

    .nav {
      margin-inline: 0.5rem;
    }

    .nav__inner {
      gap: 0.55rem;
      padding-inline: 0.65rem;
    }

    .nav__actions {
      gap: 0.45rem;
    }

    .nav__brand span,
    .nav__cta {
      white-space: nowrap;
    }

    .nav__lang-opt {
      min-width: 1.95rem;
      min-height: 1.65rem;
      padding: 0.12em 0.42em;
      font-size: 0.58rem;
      letter-spacing: 0.1em;
    }

    .nav__cta {
      font-size: 0.62rem;
      padding: 0.5em 0.85em;
    }
  }
</style>
