---
/**
 * Savings Forecast — shareable ops outlook page at /forecast.
 *
 * Guided wizard (preset → tune → reveal). Pure client-side calculation.
 * Customer-facing name is Forecast / Savings Outlook — never "calculator".
 */
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import {
  PRESETS,
  RFT_LIFT_REALIZATION,
  TIME_RATE_PER_MINUTE,
} from "../lib/forecast/model";

const SITE_TITLE = "Savings Forecast — Color Brain";
const SITE_DESCRIPTION =
  "Estimate the annual savings range Color Brain could unlock for your mill by lifting right-first-time (RFT) — rework, dye, water, energy, and time — then book a pilot.";
const SITE_URL = "https://colorbrain.co/forecast";

const FONTSHARE_CSS =
  "https://api.fontshare.com/v2/css?f[]=clash-display@500,600&f[]=satoshi@400,500,700&display=swap";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE_TITLE}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <meta property="og:title" content={SITE_TITLE} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Color Brain" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={SITE_TITLE} />
    <meta name="twitter:description" content={SITE_DESCRIPTION} />
    <meta name="theme-color" content="#0a0b10" />
    <link rel="canonical" href={SITE_URL} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preload" as="style" href={FONTSHARE_CSS} />
    <link
      rel="stylesheet"
      href={FONTSHARE_CSS}
      media="print"
      onload="this.media='all'"
    />
    <noscript><link rel="stylesheet" href={FONTSHARE_CSS} /></noscript>
    <link
      rel="preload"
      href="/fonts/IBMPlexMono-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body id="top" class="forecast-page">
    <Nav path="/forecast" />

    <main class="forecast">
      <div class="container forecast__shell">
        <header class="forecast__hero">
          <p class="eyebrow">Savings outlook</p>
          <h1 class="forecast__title">What could Color Brain save your mill?</h1>
          <p class="lede forecast__lede">
            Pick a profile that fits your operation, tune the numbers that matter,
            and see a credible annual range.
          </p>
        </header>

        <div
          id="forecast-wizard"
          class="forecast__wizard"
          data-step="1"
          aria-label="Savings forecast wizard"
        >
          <!-- Progress — also clickable step nav -->
          <ol class="forecast__steps" aria-label="Wizard steps">
            <li>
              <button
                type="button"
                class="forecast__step is-active"
                data-step-indicator="1"
                data-goto-step="1"
                aria-current="step"
              >
                <span class="forecast__step-num">01</span>
                <span class="forecast__step-label">Profile</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="forecast__step"
                data-step-indicator="2"
                data-goto-step="2"
              >
                <span class="forecast__step-num">02</span>
                <span class="forecast__step-label">Tune</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="forecast__step"
                data-step-indicator="3"
                data-goto-step="3"
              >
                <span class="forecast__step-num">03</span>
                <span class="forecast__step-label">Outlook</span>
              </button>
            </li>
          </ol>

          <div class="forecast__stage" data-step-stage>
          <!-- Step 1: Preset -->
          <section
            class="forecast__panel is-active"
            data-step-panel="1"
            aria-labelledby="step1-title"
          >
            <h2 id="step1-title" class="forecast__panel-title">Choose your mill profile</h2>
            <p class="forecast__panel-lede">
              Presets prefill every input with a starting point. You can override
              any value on the next step.
            </p>
            <div class="forecast__presets" role="group" aria-label="Mill size presets">
              {
                PRESETS.map((p) => (
                  <button
                    type="button"
                    class="forecast__preset"
                    data-preset={p.id}
                    aria-pressed="false"
                  >
                    <span class="forecast__preset-label">{p.label}</span>
                    <span class="forecast__preset-hint">{p.hint}</span>
                  </button>
                ))
              }
            </div>
            <div class="forecast__actions">
              <button type="button" class="btn btn--primary" data-goto-2>
                Continue with this profile
              </button>
            </div>
          </section>

          <!-- Step 2: Tune -->
          <section
            class="forecast__panel"
            data-step-panel="2"
            hidden
            aria-hidden="true"
            aria-labelledby="step2-title"
          >
            <div class="forecast__panel-head">
              <div>
                <h2 id="step2-title" class="forecast__panel-title">Tune your operation</h2>
                <p class="forecast__panel-lede">
                  Prefills come from your preset — adjust any of them.
                  Currency is USD.
                </p>
              </div>
              <div class="forecast__preview" aria-live="polite">
                <span class="forecast__preview-label">Expected annual</span>
                <span class="forecast__preview-value" data-preview-value>$0</span>
              </div>
            </div>

            <div class="forecast__fields">
              <label class="forecast__field" for="batchesPerMonth">
                <span class="forecast__field-top">
                  <span
                    class="forecast__field-name"
                    tabindex="0"
                    data-tip="Production dye lots you run each month"
                  >Batches / month</span>
                  <span class="forecast__field-tag">batches</span>
                </span>
                <input
                  id="batchesPerMonth"
                  name="batchesPerMonth"
                  type="number"
                  min="0"
                  max="50000"
                  step="1"
                  inputmode="numeric"
                />
              </label>
              <label class="forecast__field" for="currentRft">
                <span class="forecast__field-top">
                  <span
                    class="forecast__field-name"
                    tabindex="0"
                    data-tip="Share of batches that pass on the first attempt today"
                  >Current RFT</span>
                  <span class="forecast__field-tag">right first time</span>
                </span>
                <input
                  id="currentRft"
                  name="currentRft"
                  type="number"
                  min="0"
                  max="100"
                  step="0.5"
                  inputmode="decimal"
                />
              </label>
              <label class="forecast__field" for="targetRft">
                <span class="forecast__field-top">
                  <span
                    class="forecast__field-name"
                    tabindex="0"
                    data-tip="Where first-attempt yield could land — savings scale with this lift"
                  >Target RFT</span>
                  <span class="forecast__field-tag">with Color Brain</span>
                </span>
                <input
                  id="targetRft"
                  name="targetRft"
                  type="number"
                  min="0"
                  max="100"
                  step="0.5"
                  inputmode="decimal"
                />
              </label>
              <label class="forecast__field" for="costPerRework">
                <span class="forecast__field-top">
                  <span
                    class="forecast__field-name"
                    tabindex="0"
                    data-tip="Labour and overhead per correction, excluding dye, water, and energy"
                  >Cost per rework</span>
                  <span class="forecast__field-tag">labour &amp; overhead</span>
                </span>
                <input
                  id="costPerRework"
                  name="costPerRework"
                  type="number"
                  min="0"
                  step="10"
                  inputmode="decimal"
                />
              </label>
              <label class="forecast__field" for="dyePerRework">
                <span class="forecast__field-top">
                  <span
                    class="forecast__field-name"
                    tabindex="0"
                    data-tip="Dye and chemicals for one correction cycle"
                  >Dye cost</span>
                  <span class="forecast__field-tag">per rework</span>
                </span>
                <input
                  id="dyePerRework"
                  name="dyePerRework"
                  type="number"
                  min="0"
                  step="5"
                  inputmode="decimal"
                />
              </label>
              <label class="forecast__field" for="waterPerRework">
                <span class="forecast__field-top">
                  <span
                    class="forecast__field-name"
                    tabindex="0"
                    data-tip="Water and effluent for one correction cycle"
                  >Water cost</span>
                  <span class="forecast__field-tag">per rework</span>
                </span>
                <input
                  id="waterPerRework"
                  name="waterPerRework"
                  type="number"
                  min="0"
                  step="1"
                  inputmode="decimal"
                />
              </label>
              <label class="forecast__field" for="energyPerRework">
                <span class="forecast__field-top">
                  <span
                    class="forecast__field-name"
                    tabindex="0"
                    data-tip="Steam and power for one correction cycle"
                  >Energy cost</span>
                  <span class="forecast__field-tag">per rework</span>
                </span>
                <input
                  id="energyPerRework"
                  name="energyPerRework"
                  type="number"
                  min="0"
                  step="1"
                  inputmode="decimal"
                />
              </label>
              <label class="forecast__field" for="cycleMinutes">
                <span class="forecast__field-top">
                  <span
                    class="forecast__field-name"
                    tabindex="0"
                    data-tip="Machine and lab time tied up per correction"
                  >Time per rework</span>
                  <span class="forecast__field-tag">minutes</span>
                </span>
                <input
                  id="cycleMinutes"
                  name="cycleMinutes"
                  type="number"
                  min="0"
                  step="5"
                  inputmode="numeric"
                />
              </label>
            </div>

            <div class="forecast__actions">
              <button type="button" class="btn btn--ghost" data-back-1>Back</button>
              <button type="button" class="btn btn--primary" data-goto-3>
                Reveal outlook
              </button>
            </div>
          </section>

          <!-- Step 3: Reveal -->
          <section
            class="forecast__panel"
            data-step-panel="3"
            hidden
            aria-hidden="true"
            aria-labelledby="step3-title"
          >
            <h2 id="step3-title" class="forecast__panel-title">Your annual savings outlook</h2>
            <p class="forecast__meta" data-out-meta aria-live="polite">
              <span data-meta-batches>—</span>
              <span class="forecast__meta-sep" aria-hidden="true">·</span>
              <span data-meta-rft>—</span>
              <span class="forecast__meta-sep" aria-hidden="true">·</span>
              <span class="forecast__meta-avoided"
                >~<span data-meta-avoided>—</span> avoided</span
              >
            </p>

            <div
              class="forecast__range"
              role="radiogroup"
              aria-label="Annual savings range — choose a scenario"
              data-scenario-group
            >
              <button
                type="button"
                class="forecast__range-card"
                data-scenario="conservative"
                role="radio"
                aria-checked="false"
                tabindex="-1"
              >
                <span class="forecast__range-label">Conservative</span>
                <span class="forecast__range-value" data-out-conservative>$0</span>
              </button>
              <button
                type="button"
                class="forecast__range-card is-selected"
                data-scenario="expected"
                role="radio"
                aria-checked="true"
                tabindex="0"
              >
                <span class="forecast__range-label">Expected</span>
                <span class="forecast__range-value" data-out-expected>$0</span>
              </button>
              <button
                type="button"
                class="forecast__range-card"
                data-scenario="optimistic"
                role="radio"
                aria-checked="false"
                tabindex="-1"
              >
                <span class="forecast__range-label">Optimistic</span>
                <span class="forecast__range-value" data-out-optimistic>$0</span>
              </button>
            </div>

            <h3 class="forecast__subhead" data-breakdown-title>Expected breakdown</h3>
            <div class="forecast__breakdown-wrap">
              <div
                class="forecast__breakdown-stack"
                data-breakdown-stack
                aria-hidden="true"
                title="Share of total savings by category"
              >
                <span class="forecast__breakdown-seg" data-stack="rework"></span>
                <span class="forecast__breakdown-seg" data-stack="dye"></span>
                <span class="forecast__breakdown-seg" data-stack="water"></span>
                <span class="forecast__breakdown-seg" data-stack="energy"></span>
                <span class="forecast__breakdown-seg" data-stack="time"></span>
              </div>
              <ul class="forecast__breakdown" aria-label="Savings by category">
                <li data-cat="rework">
                  <div class="forecast__breakdown-head">
                    <span class="forecast__breakdown-label">
                      <span class="forecast__breakdown-swatch" aria-hidden="true"></span>
                      Labour &amp; overhead avoided
                    </span>
                    <span class="forecast__breakdown-val" data-out-cat="rework">$0</span>
                  </div>
                  <div class="forecast__breakdown-track" aria-hidden="true">
                    <div class="forecast__breakdown-bar" data-bar="rework"></div>
                  </div>
                </li>
                <li data-cat="dye">
                  <div class="forecast__breakdown-head">
                    <span class="forecast__breakdown-label">
                      <span class="forecast__breakdown-swatch" aria-hidden="true"></span>
                      Dye
                    </span>
                    <span class="forecast__breakdown-val" data-out-cat="dye">$0</span>
                  </div>
                  <div class="forecast__breakdown-track" aria-hidden="true">
                    <div class="forecast__breakdown-bar" data-bar="dye"></div>
                  </div>
                </li>
                <li data-cat="water">
                  <div class="forecast__breakdown-head">
                    <span class="forecast__breakdown-label">
                      <span class="forecast__breakdown-swatch" aria-hidden="true"></span>
                      Water
                    </span>
                    <span class="forecast__breakdown-val" data-out-cat="water">$0</span>
                  </div>
                  <div class="forecast__breakdown-track" aria-hidden="true">
                    <div class="forecast__breakdown-bar" data-bar="water"></div>
                  </div>
                </li>
                <li data-cat="energy">
                  <div class="forecast__breakdown-head">
                    <span class="forecast__breakdown-label">
                      <span class="forecast__breakdown-swatch" aria-hidden="true"></span>
                      Energy
                    </span>
                    <span class="forecast__breakdown-val" data-out-cat="energy">$0</span>
                  </div>
                  <div class="forecast__breakdown-track" aria-hidden="true">
                    <div class="forecast__breakdown-bar" data-bar="energy"></div>
                  </div>
                </li>
                <li data-cat="time">
                  <div class="forecast__breakdown-head">
                    <span class="forecast__breakdown-label">
                      <span class="forecast__breakdown-swatch" aria-hidden="true"></span>
                      Time (cycle opportunity)
                    </span>
                    <span class="forecast__breakdown-val" data-out-cat="time">$0</span>
                  </div>
                  <div class="forecast__breakdown-track" aria-hidden="true">
                    <div class="forecast__breakdown-bar" data-bar="time"></div>
                  </div>
                </li>
              </ul>
            </div>

            <details class="forecast__method">
              <summary>
                <span class="forecast__method-summary-label">How we calculate</span>
              </summary>
              <div class="forecast__method-body">
                <p class="forecast__method-lede">
                  Savings scale with your RFT lift (target − current) and the cost of
                  each avoided rework.
                </p>

                <p class="forecast__method-eq" data-method-rate>
                  annual savings
                  <span class="forecast__method-op">≈</span>
                  batches/yr
                  <span class="forecast__method-op">×</span>
                  RFT lift
                  <span class="forecast__method-op">×</span>
                  cost / rework
                </p>

                <div class="forecast__method-band-wrap">
                  <p class="forecast__method-band-caption">
                    Scenarios scale how much of <em>your stated RFT lift</em> we count
                    — not every miss is a full-cost rework, and some lifts overshoot.
                  </p>
                  <div
                    class="forecast__method-band"
                    data-method-reduction
                    role="list"
                    aria-label="How much of your stated RFT lift each scenario counts"
                  >
                    <div class="forecast__method-band-item" role="listitem">
                      <span class="forecast__method-band-label">Conservative</span>
                      <span class="forecast__method-band-val"
                        >{RFT_LIFT_REALIZATION.conservative}×</span
                      >
                      <span class="forecast__method-band-unit">of your lift</span>
                    </div>
                    <div
                      class="forecast__method-band-item forecast__method-band-item--mid"
                      role="listitem"
                    >
                      <span class="forecast__method-band-label">Expected</span>
                      <span class="forecast__method-band-val"
                        >{RFT_LIFT_REALIZATION.expected}×</span
                      >
                      <span class="forecast__method-band-unit">of your lift</span>
                    </div>
                    <div class="forecast__method-band-item" role="listitem">
                      <span class="forecast__method-band-label">Optimistic</span>
                      <span class="forecast__method-band-val"
                        >{RFT_LIFT_REALIZATION.optimistic}×</span
                      >
                      <span class="forecast__method-band-unit">of your lift</span>
                    </div>
                  </div>
                </div>

                <p class="forecast__method-note">
                  Cost / rework = labour + dye + water + energy + time
                  <span class="forecast__method-pill"
                    >${TIME_RATE_PER_MINUTE.toFixed(2)}/min</span
                  >
                </p>

                <p class="forecast__method-foot">
                  Planning estimate — not a quote. Coefficients are provisional.
                </p>
              </div>
            </details>

            <p class="forecast__disclaimer">
              Estimate based on your RFT lift and provisional cost assumptions.
              Actual results vary by product mix, addressable history, and plant
              conditions. This is a planning outlook, not a commercial commitment.
            </p>

            <div class="forecast__actions forecast__actions--cta">
              <a
                class="btn btn--primary"
                href="/#contact"
                data-cta-pilot
              >Book a pilot</a>
              <button type="button" class="btn btn--ghost" data-cta-copy>
                Copy link
              </button>
              <button type="button" class="btn btn--ghost" data-back-2>
                Adjust numbers
              </button>
            </div>
            <p class="forecast__tertiary">
              <a href="/">Back to Color Brain</a>
            </p>
          </section>
          </div>
        </div>
      </div>
    </main>

    <Footer />

    <script>
      import { initForecastWizard } from "../lib/forecast/wizard";

      const root = document.getElementById("forecast-wizard");
      if (root) initForecastWizard(root);
    </script>
  </body>
</html>

<style>
  .forecast-page {
    background:
      radial-gradient(
        circle at 18% 0%,
        rgba(127, 216, 232, 0.07),
        transparent 32rem
      ),
      radial-gradient(
        circle at 82% 12%,
        rgba(78, 82, 124, 0.1),
        transparent 28rem
      ),
      var(--bg);
  }

  .forecast {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) var(--section-pad);
    min-height: 70vh;
  }

  .forecast__shell {
    max-width: 920px;
  }

  .forecast__hero {
    margin-bottom: 2.5rem;
  }

  .forecast__title {
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    margin-top: 1.1rem;
    max-width: 18ch;
  }

  .forecast__lede {
    max-width: 52ch;
  }

  .forecast__wizard {
    border: 1px solid color-mix(in srgb, var(--holo) 12%, var(--line));
    border-radius: calc(var(--radius) + 4px);
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--surface-raised) 88%, transparent),
        color-mix(in srgb, var(--surface) 92%, transparent)
      );
    box-shadow:
      0 24px 64px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(127, 216, 232, 0.06);
    padding: clamp(1.4rem, 3vw, 2.25rem);
    position: relative;
    overflow: hidden;
  }

  .forecast__wizard::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(127, 216, 232, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(127, 216, 232, 0.03) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at 50% 0%, #000 20%, transparent 75%);
    pointer-events: none;
  }

  .forecast__steps {
    position: relative;
    z-index: 1;
    list-style: none;
    display: flex;
    gap: 0.75rem;
    padding: 0;
    margin: 0 0 2rem;
    flex-wrap: wrap;
  }

  .forecast__steps > li {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .forecast__step {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink-faint);
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: transparent;
    cursor: pointer;
    transition:
      border-color 280ms ease,
      color 280ms ease,
      box-shadow 280ms ease,
      background 280ms ease;
  }

  .forecast__step:hover {
    border-color: color-mix(in srgb, var(--ink-faint) 50%, var(--line));
    color: var(--ink-dim);
  }

  .forecast__step:focus-visible {
    outline: none;
    border-color: color-mix(in srgb, var(--holo) 55%, var(--line));
    box-shadow: 0 0 0 3px rgba(127, 216, 232, 0.14);
  }

  .forecast__step.is-active {
    border-color: color-mix(in srgb, var(--holo) 55%, var(--line));
    color: var(--holo);
    box-shadow: 0 0 18px rgba(127, 216, 232, 0.12);
    cursor: default;
  }

  .forecast__step.is-active:hover {
    color: var(--holo);
    border-color: color-mix(in srgb, var(--holo) 55%, var(--line));
  }

  .forecast__step.is-done {
    color: var(--ink-dim);
    border-color: var(--line);
  }

  .forecast__step-num {
    opacity: 0.7;
  }

  /* Step stage — soft crossfade + light slide; height eases between panels. */
  .forecast__stage {
    position: relative;
    overflow: hidden;
    transition: height 400ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .forecast__panel {
    position: relative;
    z-index: 1;
  }

  .forecast__panel:not(.is-active):not(.is-exit):not(.is-enter) {
    display: none;
  }

  .forecast__panel.is-exit {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    z-index: 1;
    pointer-events: none;
  }

  .forecast__panel.is-enter {
    position: relative;
    z-index: 2;
  }

  .forecast__panel.is-exit-forward {
    animation: forecast-panel-exit-forward 360ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .forecast__panel.is-exit-back {
    animation: forecast-panel-exit-back 360ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .forecast__panel.is-enter-forward {
    animation: forecast-panel-enter-forward 400ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
  }

  .forecast__panel.is-enter-back {
    animation: forecast-panel-enter-back 400ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
