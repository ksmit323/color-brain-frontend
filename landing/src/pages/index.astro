---
/**
 * colorbrain.co — English marketing home (default locale, unprefixed).
 */
import Marketing from "../layouts/Marketing.astro";
import Loader from "../components/Loader.astro";
import Nav from "../components/Nav.astro";
import StageLayer from "../components/StageLayer.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Proof from "../components/Proof.astro";
import CaseStudies from "../components/CaseStudies.astro";
import WhoItsFor from "../components/WhoItsFor.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import type { Locale } from "../i18n/locales";

const locale: Locale = "en";
const path = "/";
---

<Marketing locale={locale} page="home" softEntry>
  <Loader />
  <Nav locale={locale} path={path} />
  <main>
    <div id="stage" data-scene-phase="index">
      <StageLayer />
      <Hero locale={locale} />
      <HowItWorks locale={locale} />
    </div>
    <Problem locale={locale} />
    <Proof locale={locale} />
    <CaseStudies locale={locale} />
    <WhoItsFor locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
  <script>
    import { initMotion } from "../lib/motion";
    import { initCaseBrowser } from "../lib/caseBrowser";

    initMotion();
    initCaseBrowser();

    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const webgl2 = (() => {
      try {
        return document.createElement("canvas").getContext("webgl2") !== null;
      } catch {
        return false;
      }
    })();
    if (!reducedMotion && webgl2) {
      const boot = () => {
        setTimeout(async () => {
          const { initBrain } = await import("../lib/brain/index");
          const ambient =
            matchMedia("(pointer: coarse)").matches || window.innerWidth < 768;
          initBrain(ambient ? "ambient" : "full");
        }, 150);
      };
      if (document.readyState === "complete") boot();
      else window.addEventListener("load", boot, { once: true });
    }
  </script>
</Marketing>
